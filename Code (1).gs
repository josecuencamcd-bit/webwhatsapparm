/** Paso 1 del ingreso: ¿el correo está autorizado y ya tiene clave? */
function api_correo(correo) {
  var e = normCorreo_(correo);
  if (!e) throw new Error('Escribe un correo válido.');
  var u = usuarios_()[e];
  if (!u) {
    var sol = solicitudAcceso_(e);
    if (sol && sol.estado === 'Pendiente') throw new Error('Tu solicitud de acceso está pendiente. Cuando el administrador la apruebe te avisaremos por correo.');
    if (sol && sol.estado === 'Rechazada') throw new Error('Tu solicitud de acceso no fue aprobada. Habla con el administrador.');
    return { nuevo: true, registrado: false, nombre: '' };
  }
  if (u.b) throw new Error('Este acceso está bloqueado.');
  return { registrado: !!u.h, nombre: u.nh || u.h ? u.n : '' };
}
function api_login(correo, clave) {
  var e = normCorreo_(correo), cache = CacheService.getScriptCache(), kf = 'fu_' + e;
  var u = e && usuarios_()[e];
  if (!u || u.b) throw new Error('Correo no autorizado.');
  if (!u.h) throw new Error('Este correo aún no tiene clave. Crea una.');
  if (Number(cache.get(kf) || 0) >= 5) throw new Error('Demasiados intentos. Espera un minuto.');
  if (hashClave_(e, String(clave == null ? '' : clave)) !== u.h) {
    cache.put(kf, String(Number(cache.get(kf) || 0) + 1), 60);
    Utilities.sleep(1200);
    throw new Error('Clave incorrecta.');
  }
  cache.remove(kf);
  marcarAcceso_(u.fila);
  return sesionDe_(e, u);
}
/** Primera vez: la persona crea su propia clave. Solo si su celda de clave está vacía. */
function api_registrar(correo, clave, nombre) {
  var e = normCorreo_(correo), c = String(clave == null ? '' : clave);
  var nom = texto_(nombre, 60).replace(/\s+/g, ' ');
  if (nom.split(' ').length < 2 || nom.length < 5) throw new Error('Escribe tu nombre y apellido.');
  if (c.length < 4 || c.length > 40) throw new Error('La clave debe tener entre 4 y 40 caracteres.');
  return conLock_(function () {
    CacheService.getScriptCache().remove('usr');
    var u = e && usuarios_()[e];
