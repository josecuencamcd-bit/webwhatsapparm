/** Recuperar clave: se envía un código de 6 dígitos al correo de la persona (vale 10 minutos, 5 intentos). */
function api_olvide(correo) {
  var e = normCorreo_(correo), cache = CacheService.getScriptCache();
  var u = e && usuarios_()[e];
  if (!u || u.b) throw new Error('Correo no autorizado.');
  if (!u.h) throw new Error('Este correo aún no tiene clave. Crea una.');
  var kn = 'ro_' + e, n = Number(cache.get(kn) || 0);
  if (n >= 3) throw new Error('Ya pediste varios códigos. Espera una hora o pídele al administrador que restablezca tu clave.');
  if (MailApp.getRemainingDailyQuota() < 1) throw new Error('Hoy no se pueden enviar más correos. Pídele al administrador que restablezca tu clave.');
  var uid = Utilities.getUuid().replace(/[^0-9a-f]/g, ''), codigo = String(100000 + (parseInt(uid.slice(0, 7), 16) % 900000));
  cache.put('rc_' + e, hashClave_(e, codigo), 600);
  cache.remove('rf_' + e);
  cache.put(kn, String(n + 1), 3600);
  MailApp.sendEmail({ to: e, name: 'ARM Global', subject: 'Tu código para recuperar la clave',
    body: 'Hola ' + u.n + ',\n\nTu código es: ' + codigo + '\n\nVale por 10 minutos. Escríbelo en la app para crear una clave nueva.\n' +
          'Si tú no lo pediste, ignora este correo.\n\nARM Global' });
  return { ok: true };
}
function api_restablecer(correo, codigo, clave) {
  var e = normCorreo_(correo), cache = CacheService.getScriptCache(), c = String(clave == null ? '' : clave);
  if (c.length < 4 || c.length > 40) throw new Error('La clave debe tener entre 4 y 40 caracteres.');
  var u = e && usuarios_()[e];
  if (!u || u.b || !u.h) throw new Error('Correo no autorizado.');
  var real = cache.get('rc_' + e), kf = 'rf_' + e, f = Number(cache.get(kf) || 0);
  if (!real) throw new Error('El código venció. Pide uno nuevo.');
  if (f >= 5) { cache.remove('rc_' + e); throw new Error('Demasiados intentos. Pide un código nuevo.'); }
  if (hashClave_(e, String(codigo == null ? '' : codigo).replace(/\D/g, '')) !== real) {
    cache.put(kf, String(f + 1), 600); Utilities.sleep(1200);
    throw new Error('Código incorrecto.');
  }
  return conLock_(function () {
    CacheService.getScriptCache().remove('usr');
    var v = usuarios_()[e];
    if (!v || !v.fila) throw new Error('Correo no autorizado.');
    v.h = hashClave_(e, c);
    var ch = clavesHoja_(), cel = ch.getRange(v.fila, 2); cel.setNumberFormat('@'); cel.setValue(v.h);
    marcarAcceso_(v.fila);
    cache.remove('rc_' + e); cache.remove(kf);
    CacheService.getScriptCache().remove('usr');
    return sesionDe_(e, v);
  });
}

/** Quién está conectado: cada consulta renueva la marca de la persona por 50 segundos. */
function marcarPresencia_(u, campus) {
  CacheService.getScriptCache().put('p_' + u.correo, JSON.stringify({ n: u.nombre, c: campus }), 50);
}
function conectados_() {
  var cache = CacheService.getScriptCache(), claves = Object.keys(usuarios_()).map(function (e) { return 'p_' + e; }), out = [];
  for (var i = 0; i < claves.length; i += 100) {
    var got = cache.getAll(claves.slice(i, i + 100));
    for (var k in got) { try { var o = JSON.parse(got[k]); out.push({ n: o.n, c: o.c }); } catch (e) {} }
  }
  out.sort(function (a, b) { return a.n < b.n ? -1 : a.n > b.n ? 1 : 0; });
  return out;
}

/* ---------- Validación del encuentro ---------- */
function args_(a) {
  var usuario = usuarioDe_(a && a.tk);
  if (!esFinanzas_(usuario)) throw new Error('Tu perfil no tiene acceso a esta sección.');
  if (!a || CAMPUS.indexOf(a.campus) < 0) throw new Error('Campus no válido.');
  if (ENCUENTROS[a.campus].indexOf(a.encuentro) < 0) throw new Error('Encuentro no válido.');
  var evento = '';
  if (a.encuentro === 'Evento Especial') {
    evento = String(a.evento || '');
    if (evento && EVENTOS.indexOf(evento) < 0) throw new Error('Evento no válido.');
  }
  var f = String(a.fecha || '');
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(f);
  if (!m) throw new Error('Fecha no válida.');
  var d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3], 12));
  if (d.getUTCFullYear() !== +m[1] || d.getUTCMonth() !== +m[2] - 1 || d.getUTCDate() !== +m[3]) throw new Error('Fecha no válida.');
  if (DIA[a.encuentro] !== undefined && d.getUTCDay() !== DIA[a.encuentro]) throw new Error('Esa fecha no corresponde al día de este encuentro.');
  return { campus: a.campus, encuentro: a.encuentro, evento: evento, fecha: f, u: usuario,
           key: [a.campus, a.encuentro, evento, f].join('|') };
}
/** Editable: el mismo día, sin finalizar, o con la clave de administrador. */
function puedeEditar_(a, finalizado, clave) {
  if (clave === 'AUT') {
    if (autorizado_(a)) return true;
    throw new Error('La autorización venció o no existe. Pídela de nuevo.');
  }
  if (clave) {
    if (claveOk_(clave)) return true;
    throw new Error('Clave de administrador incorrecta.');
  }
  if (finalizado) throw new Error('Este encuentro ya está finalizado.');
  if (DIA[a.encuentro] !== undefined && a.fecha !== hoy_()) throw new Error('Solo se puede registrar el mismo día del encuentro.');
  return true;
}

/* ---------- Hojas ---------- */
function hojas_(campus) {
  var ss = ss_();
  function crear(nombre, cols) {
    var sh = ss.getSheetByName(nombre);
    if (!sh) {
      sh = ss.insertSheet(nombre);
      if (sh.getMaxColumns() < cols.length) sh.insertColumnsAfter(sh.getMaxColumns(), cols.length - sh.getMaxColumns());
      sh.getRange(1, 1, 1, cols.length).setValues([cols]).setFontWeight('bold');
      sh.setFrozenRows(1);
    } else if (sh.getLastColumn() < cols.length) {
      /* Hoja creada con una versión anterior: agrega las columnas nuevas al final. */
      var ya = sh.getLastColumn();
      if (sh.getMaxColumns() < cols.length) sh.insertColumnsAfter(sh.getMaxColumns(), cols.length - sh.getMaxColumns());
      sh.getRange(1, ya + 1, 1, cols.length - ya).setValues([cols.slice(ya)]).setFontWeight('bold');
    }
    return sh;
  }
  if (CAMPUS.indexOf(campus) < 0) throw new Error('Campus no válido.');
  /* Cada campus tiene sus propias hojas: nada se mezcla entre Punta Arenas y Puerto Natales. */
  return { ses: crear('Sesiones - ' + campus, SES_COLS), apo: crear('Aportes - ' + campus, APO_COLS) };
}
function filaSesion_(sh, key) {
  var n = sh.getLastRow() - 1;
  if (n < 1) return 0;
  var col = sh.getRange(2, 1, n, 1).getValues();
  for (var i = 0; i < col.length; i++) if (String(col[i][0]) === key) return i + 2;
  return 0;
}
function crearSesion_(sh, a) {
  var row = new Array(SES_COLS.length);
  SES_COLS.forEach(function (c, i) {
    var v = '';
    if (c === 'key') v = a.key; else if (c === 'campus') v = a.campus; else if (c === 'encuentro') v = a.encuentro;
    else if (c === 'evento') v = a.evento; else if (c === 'fecha') v = a.fecha; else if (c === 'responsable') v = equiposVigentes_()[0];
    else if (c === 'finalizado') v = 'FALSE'; else if (c === 'modalidad') v = 'Presencial';
    else if (c === 'aceptaron' || c === 'onAcepto' || c === 'onEspect' || c.indexOf('asis_') === 0 || c.indexOf('vol_') === 0) v = 0;
    else if (c === 'actualizado') v = ahoraTxt_();
    row[i] = v;
  });
  var r = sh.getLastRow() + 1, rg = sh.getRange(r, 1, 1, SES_COLS.length);
  rg.setNumberFormat('@'); rg.setValues([row]);
  return r;
}
function celda_(sh, row, col, v) {
  var c = sh.getRange(row, SES_COLS.indexOf(col) + 1);
  c.setNumberFormat('@'); c.setValue(v);
}

/* ---------- Lectura de un encuentro ---------- */
function leerSesion_(a) {
  var h = hojas_(a.campus);
  var res = { responsable: equiposVigentes_()[0], finalizado: false, aportes: [], fotos: [], editor: '', actualizado: '',
              reporte: { modalidad: 'Presencial', predicador: '', mensaje: '', lideres: '', adm: '',
                         aceptaron: 0, onAcepto: 0, onEspect: 0, asis: {}, vol: {} } };
  ASIS_IDS.forEach(function (x) { res.reporte.asis[x] = 0; });
  VOL_IDS.forEach(function (x) { res.reporte.vol[x] = 0; });
  var row = filaSesion_(h.ses, a.key);
  if (row) {
    var v = h.ses.getRange(row, 1, 1, SES_COLS.length).getValues()[0], o = {};
    SES_COLS.forEach(function (c, i) { o[c] = v[i]; });
    res.responsable = String(o.responsable) || equiposVigentes_()[0];
    res.finalizado = String(o.finalizado).toUpperCase() === 'TRUE';
    ['modalidad', 'predicador', 'mensaje', 'lideres', 'adm'].forEach(function (c) { res.reporte[c] = String(o[c] == null ? '' : o[c]); });
    ['aceptaron', 'onAcepto', 'onEspect'].forEach(function (c) { res.reporte[c] = num_(o[c]); });
    ASIS_IDS.forEach(function (x) { res.reporte.asis[x] = num_(o['asis_' + x]); });
    VOL_IDS.forEach(function (x) { res.reporte.vol[x] = num_(o['vol_' + x]); });
    res.fotos = idsFotos_(o.fotos);
    res.editor = String(o.editado_por || ''); res.actualizado = String(o.actualizado || '');
  }
  var n = h.apo.getLastRow() - 1;
  if (n > 0) {
    h.apo.getRange(2, 1, n, APO_COLS.length).getValues().forEach(function (r) {
      if (String(r[1]) !== a.key) return;
      res.aportes.push({ id: String(r[0]), nombre: String(r[6]), monto: Number(r[7]) || 0, categoria: String(r[8]), metodo: String(r[9]) });
    });
  }
  return res;
}
function idsFotos_(s) {
  var out = [], re = /\/d\/([A-Za-z0-9_-]+)/g, m, t = String(s || '');
  while ((m = re.exec(t))) out.push(m[1]);
  return out;
}

function respuesta_(a, extra) {
  var r = { rev: bump_(), hoy: hoy_(), ses: leerSesion_(a) };
  if (extra) for (var k in extra) r[k] = extra[k];
  return r;
}
/** Obtiene la fila del encuentro (la crea si no existe) comprobando permisos antes de crear. */
function sesionEditable_(h, a, clave) {
  var row = filaSesion_(h.ses, a.key), fin = false;
  if (row) fin = String(h.ses.getRange(row, SES_COLS.indexOf('finalizado') + 1).getValue()).toUpperCase() === 'TRUE';
  puedeEditar_(a, fin, clave);
  if (!row) row = crearSesion_(h.ses, a);
  return row;
}
function tocar_(h, row, u) { celda_(h.ses, row, 'actualizado', ahoraTxt_()); celda_(h.ses, row, 'editado_por', u ? u.nombre : ''); }

/* ---------- API ---------- */
function api_estado(args, revCliente) {
  var a = args_(args), r = rev_(), h = hoy_();
  marcarPresencia_(a.u, a.campus);
  var pres = conectados_();
  if (revCliente && String(revCliente) === r) return { sinCambios: true, rev: r, hoy: h, pres: pres };
  return { rev: r, hoy: h, ses: leerSesion_(a), pres: pres };
}

function api_addAporte(args, ap, clave) {
  var a = args_(args);
  if (!ap) throw new Error('Aporte no válido.');
  var nombre = texto_(ap.nombre, 60), monto = Math.floor(Number(ap.monto));
  if (!nombre) throw new Error('Falta el nombre.');
  if (!(monto > 0 && monto <= 100000000)) throw new Error('Monto no válido.');
  if (CATEGORIAS.indexOf(ap.categoria) < 0) throw new Error('Categoría no válida.');
  if (METODOS.indexOf(ap.metodo) < 0) throw new Error('Forma de pago no válida.');
  var id = /^[a-z0-9]{6,24}$/.test(String(ap.id)) ? String(ap.id) : Utilities.getUuid().replace(/-/g, '').slice(0, 12);
  return conLock_(function () {
    var h = hojas_(a.campus), row = sesionEditable_(h, a, clave);
    var n = h.apo.getLastRow() - 1, existe = false;
    if (n > 0) h.apo.getRange(2, 1, n, 1).getValues().forEach(function (r) { if (String(r[0]) === id) existe = true; });
    if (!existe) {
      var r = h.apo.getLastRow() + 1, rg = h.apo.getRange(r, 1, 1, APO_COLS.length);
      rg.setNumberFormat('@');
      rg.setValues([[id, a.key, a.campus, a.encuentro, a.evento, a.fecha, nombre, monto, ap.categoria, ap.metodo,
                     Utilities.formatDate(new Date(), TZ, 'HH:mm:ss'), a.u.nombre]]);
      tocar_(h, row, a.u);
    }
    return respuesta_(a);
  });
}

function api_delAporte(args, id, clave) {
  var a = args_(args);
  return conLock_(function () {
    var h = hojas_(a.campus), row = sesionEditable_(h, a, clave);
    var n = h.apo.getLastRow() - 1;
    if (n > 0) {
      var vals = h.apo.getRange(2, 1, n, 2).getValues();
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]) === String(id) && String(vals[i][1]) === a.key) { h.apo.deleteRow(i + 2); break; }
      }
    }
    tocar_(h, row, a.u);
    return respuesta_(a);
  });
}

function api_setCampo(args, campo, valor, clave) {
  var a = args_(args), col = String(campo), v;
  if (col === 'responsable') { if (EQUIPOS.indexOf(valor) < 0) throw new Error('Responsable no válido.'); v = valor; }
  else if (col === 'modalidad') { if (MODALIDADES.indexOf(valor) < 0) throw new Error('Modalidad no válida.'); v = valor; }
  else if (col === 'adm') { v = valor === '' ? '' : valor; if (v && EQUIPOS.indexOf(v) < 0) throw new Error('Adm. de Campus no válido.'); }
  else if (['predicador', 'mensaje', 'lideres'].indexOf(col) >= 0) v = texto_(valor, 120);
  else if (['aceptaron', 'onAcepto', 'onEspect'].indexOf(col) >= 0) v = num_(valor);
  else if (/^asis_/.test(col) && ASIS_IDS.indexOf(col.slice(5)) >= 0) v = num_(valor);
  else if (/^vol_/.test(col) && VOL_IDS.indexOf(col.slice(4)) >= 0) v = num_(valor);
  else throw new Error('Campo no válido.');
  return conLock_(function () {
    var h = hojas_(a.campus), row = sesionEditable_(h, a, clave);
    celda_(h.ses, row, col, v); tocar_(h, row, a.u);
    return respuesta_(a);
  });
}

function api_finalizar(args, clave) {
  var a = args_(args);
  return conLock_(function () {
    var h = hojas_(a.campus), row = sesionEditable_(h, a, clave);
    celda_(h.ses, row, 'finalizado', 'TRUE'); tocar_(h, row, a.u);
    return respuesta_(a);
  });
}

/* ---------- Fotos del cierre del POS ---------- */
function carpetaFotos_() {
  var p = PropertiesService.getScriptProperties(), id = p.getProperty('CARPETA');
  if (id) { try { var f = DriveApp.getFolderById(id); if (!f.isTrashed()) return f; } catch (e) {} }
  var it = DriveApp.getFoldersByName(CARPETA_FOTOS), folder = it.hasNext() ? it.next() : DriveApp.createFolder(CARPETA_FOTOS);
  p.setProperty('CARPETA', folder.getId());
  return folder;
}

function api_subirFoto(args, dataUrl, clave) {
  var a = args_(args), m = /^data:image\/jpeg;base64,([A-Za-z0-9+\/=]+)$/.exec(String(dataUrl || ''));
  if (!m) throw new Error('La foto no es válida.');
  if (m[1].length > 8000000) throw new Error('La foto es demasiado grande.');
  return conLock_(function () {
    var h = hojas_(a.campus), row = sesionEditable_(h, a, clave);
    var cell = h.ses.getRange(row, SES_COLS.indexOf('fotos') + 1), actual = String(cell.getValue() || '');
    if (idsFotos_(actual).length >= MAX_FOTOS) throw new Error('Ya hay ' + MAX_FOTOS + ' fotos en este encuentro.');
    var nombre = 'Cierre POS - ' + a.campus + ' - ' + (a.evento || a.encuentro) + ' - ' + a.fecha + ' - ' +
                 Utilities.formatDate(new Date(), TZ, 'HHmmss') + '.jpg';
    var file = carpetaFotos_().createFile(Utilities.newBlob(Utilities.base64Decode(m[1]), 'image/jpeg', nombre));
    var link = 'https://drive.google.com/file/d/' + file.getId() + '/view';
    cell.setNumberFormat('@'); cell.setValue(actual ? actual + ' ' + link : link);
    tocar_(h, row, a.u);
    return respuesta_(a, { nueva: true });
  });
}

function api_delFoto(args, id, clave) {
  var a = args_(args);
  return conLock_(function () {
    var h = hojas_(a.campus), row = sesionEditable_(h, a, clave);
    var cell = h.ses.getRange(row, SES_COLS.indexOf('fotos') + 1), ids = idsFotos_(cell.getValue());
    var i = ids.indexOf(String(id));
    if (i >= 0) {
      ids.splice(i, 1);
      cell.setNumberFormat('@');
      cell.setValue(ids.map(function (x) { return 'https://drive.google.com/file/d/' + x + '/view'; }).join(' '));
      try { DriveApp.getFileById(String(id)).setTrashed(true); } catch (e) {}
    }
    tocar_(h, row, a.u);
    return respuesta_(a);
  });
}

/** Devuelve la foto como imagen en texto. Solo entrega fotos que pertenecen a este encuentro. */
function api_getFoto(args, id) {
  var a = args_(args), h = hojas_(a.campus), row = filaSesion_(h.ses, a.key);
  if (!row) throw new Error('Foto no encontrada.');
  var ids = idsFotos_(h.ses.getRange(row, SES_COLS.indexOf('fotos') + 1).getValue());
  if (ids.indexOf(String(id)) < 0) throw new Error('Foto no encontrada.');
  var blob = DriveApp.getFileById(String(id)).getBlob();
  return 'data:image/jpeg;base64,' + Utilities.base64Encode(blob.getBytes());
}

/* ---------- Estadísticas ---------- */
var TIPOS = ['Jueves PM', 'Domingo AM', 'Domingo PM', 'Evento Especial'];
function fechaTxt_(v) {
  if (Object.prototype.toString.call(v) === '[object Date]') return Utilities.formatDate(v, TZ, 'yyyy-MM-dd');
  return String(v == null ? '' : v).slice(0, 10);
}
function sumaObj_(o) { var t = 0; for (var k in o) t += o[k]; return t; }

/** Agrupa los encuentros por día, semana (lunes a domingo) o mes. */
function serie_(lista, modo) {
  if (modo !== 'dia' && modo !== 'semana' && modo !== 'mes') return [];
  var mapa = {}, orden = [];
  lista.forEach(function (it) {
    var p = it.fecha.split('-'), d = new Date(Date.UTC(+p[0], +p[1] - 1, +p[2], 12)), k;
    if (modo === 'dia') k = it.fecha;
    else if (modo === 'mes') k = p[0] + '-' + p[1];
    else { d.setUTCDate(d.getUTCDate() - ((d.getUTCDay() + 6) % 7)); k = Utilities.formatDate(d, 'UTC', 'yyyy-MM-dd'); }
    if (!mapa[k]) { mapa[k] = { clave: k, encuentros: 0, asistencia: 0, ninos: 0, voluntarios: 0, aceptaron: 0, aportes: 0 }; orden.push(k); }
    var g = mapa[k]; g.encuentros++; g.asistencia += it.asisTotal; g.ninos += it.ninos; g.voluntarios += it.volTotal;
    g.aceptaron += it.aceptaron; g.aportes += it.aportes;
  });
  orden.sort().reverse();
  return orden.map(function (k) { return mapa[k]; });
}

function contar_(mapa, texto) {
  var t = String(texto || '').replace(/\s+/g, ' ').trim();
  if (!t) return;
  var k = t.toLowerCase();
  if (!mapa[k]) mapa[k] = { nombre: t, veces: 0 };
  mapa[k].veces++;
}
function ordenar_(mapa) {
  return Object.keys(mapa).map(function (k) { return mapa[k]; })
    .sort(function (a, b) { return b.veces - a.veces || (a.nombre < b.nombre ? -1 : 1); });
}

function statsCampus_(campus, f) {
  var h = hojas_(campus), sess = {}, lista = [];
  var n = h.ses.getLastRow() - 1;
  if (n > 0) h.ses.getRange(2, 1, n, SES_COLS.length).getValues().forEach(function (v) {
    var o = {}; SES_COLS.forEach(function (c, i) { o[c] = v[i]; });
    var fecha = fechaTxt_(o.fecha), enc = String(o.encuentro);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(fecha)) return;
    if (f.desde && fecha < f.desde) return;
    if (f.hasta && fecha > f.hasta) return;
    if (f.tipos.length && f.tipos.indexOf(enc) < 0) return;
    var it = { fecha: fecha, encuentro: enc, evento: String(o.evento || ''), finalizado: String(o.finalizado).toUpperCase() === 'TRUE',
               predicador: String(o.predicador || ''), mensaje: String(o.mensaje || ''), modalidad: String(o.modalidad || ''),
               responsable: String(o.responsable || ''), lideres: String(o.lideres || ''), adm: String(o.adm || ''),
               asis: {}, vol: {}, aceptaron: num_(o.aceptaron), onAcepto: num_(o.onAcepto), onEspect: num_(o.onEspect),
               aportes: 0, nAportes: 0, porCat: {}, porMetodo: {}, fotos: idsFotos_(o.fotos).length };
    ASIS_IDS.forEach(function (x) { it.asis[x] = num_(o['asis_' + x]); });
    VOL_IDS.forEach(function (x) { it.vol[x] = num_(o['vol_' + x]); });
    CATEGORIAS.forEach(function (c) { it.porCat[c] = 0; });
    METODOS.forEach(function (m) { it.porMetodo[m] = 0; });
    it.asisTotal = sumaObj_(it.asis); it.volTotal = sumaObj_(it.vol);
    it.ninos = it.asis.kids + it.asis.tweens + it.asis.bebes;
    sess[String(o.key)] = it; lista.push(it);
  });
  var m = h.apo.getLastRow() - 1;
  if (m > 0 && lista.length) h.apo.getRange(2, 1, m, APO_COLS.length).getValues().forEach(function (r) {
    var it = sess[String(r[1])]; if (!it) return;
    var monto = Number(r[7]) || 0, cat = String(r[8]), met = String(r[9]);
    it.aportes += monto; it.nAportes++;
    it.porCat[cat] = (it.porCat[cat] || 0) + monto; it.porMetodo[met] = (it.porMetodo[met] || 0) + monto;
  });
  lista.sort(function (a, b) { return a.fecha < b.fecha ? 1 : a.fecha > b.fecha ? -1 : (a.encuentro < b.encuentro ? -1 : 1); });
  if (f.ultimos > 0) lista = lista.slice(0, f.ultimos);
  var R = { encuentros: lista.length, asistencia: 0, ninos: 0, voluntarios: 0, personas: 0, aceptaron: 0, aportes: 0, nAportes: 0,
            porCat: {}, porMetodo: {}, porSala: {}, porVol: {}, predicadores: {}, modalidades: {}, responsables: {}, adms: {}, lideres: {}, onAcepto: 0, onEspect: 0 };
  VOL_IDS.forEach(function (x) { R.porVol[x] = 0; });
  CATEGORIAS.forEach(function (c) { R.porCat[c] = 0; });
  METODOS.forEach(function (x) { R.porMetodo[x] = 0; });
  ASIS_IDS.forEach(function (x) { R.porSala[x] = 0; });
  lista.forEach(function (it) {
    R.asistencia += it.asisTotal; R.ninos += it.ninos; R.voluntarios += it.volTotal; R.aceptaron += it.aceptaron;
    R.aportes += it.aportes; R.nAportes += it.nAportes;
    for (var c in it.porCat) R.porCat[c] = (R.porCat[c] || 0) + it.porCat[c];
    for (var x in it.porMetodo) R.porMetodo[x] = (R.porMetodo[x] || 0) + it.porMetodo[x];
    ASIS_IDS.forEach(function (k) { R.porSala[k] += it.asis[k]; });
    VOL_IDS.forEach(function (k) { R.porVol[k] += it.vol[k]; });
    R.onAcepto += it.onAcepto; R.onEspect += it.onEspect;
    contar_(R.predicadores, it.predicador); contar_(R.modalidades, it.modalidad); contar_(R.responsables, it.responsable); contar_(R.adms, it.adm);
    it.lideres.split(',').forEach(function (x) { contar_(R.lideres, x); });
  });
  ['predicadores', 'modalidades', 'responsables', 'adms', 'lideres'].forEach(function (k) { R[k] = ordenar_(R[k]); });
  R.personas = R.asistencia + R.voluntarios;
  R.promAsistencia = R.encuentros ? Math.round(R.asistencia / R.encuentros) : 0;
  R.promAportes = R.encuentros ? Math.round(R.aportes / R.encuentros) : 0;
  return { campus: campus, resumen: R, detalle: lista, series: serie_(lista, f.agrupar) };
}

/** Estadísticas por campus, filtradas por fechas, tipo de encuentro y cantidad. Solo con la clave de Estadísticas. */
function api_stats(clave, filtros) {
  var uu = usuarioDe_(filtros && filtros.tk);
  if (!verPanorama_(uu)) throw new Error('Tu perfil no tiene acceso a las estadísticas.');
  var q = filtros || {}, re = /^\d{4}-\d{2}-\d{2}$/;
  var f = { desde: re.test(String(q.desde || '')) ? String(q.desde) : '', hasta: re.test(String(q.hasta || '')) ? String(q.hasta) : '',
            tipos: [], ultimos: Math.min(num_(q.ultimos), 500), agrupar: ['dia', 'semana', 'mes'].indexOf(q.agrupar) >= 0 ? q.agrupar : '' };
  (q.tipos || []).forEach(function (t) { if (TIPOS.indexOf(t) >= 0 && f.tipos.indexOf(t) < 0) f.tipos.push(t); });
  var campus = q.campus === 'Ambos' || !q.campus ? CAMPUS : (CAMPUS.indexOf(q.campus) >= 0 ? [q.campus] : null);
  if (!campus) throw new Error('Campus no válido.');
  return { hoy: hoy_(), filtros: f, campus: campus.map(function (c) { return statsCampus_(c, f); }) };
}

/* ======================================================================
   ECOSISTEMA POR PERFILES
   Hoja de correos: A correo · B nombre · C Bloqueado · D Rol (uno o varios: "Ministro, Administrador, Líder")
   · E Área (para Líder y Voluntario) · F Campus · G Desde (fecha) · H Nuevo rol · I Nueva área.
   Desde la fecha de G la persona pasa sola a los roles de H (y al área de I si la hay).
   ====================================================================== */
/* 'Pastor de campus' lidera un campus; 'Pastor' es otro rol (por ejemplo, Newman y Emily desde el 15/11). Los dos ven todo y aprueban como Pastor. */
var ROLES = ['Pastor principal', 'Pastor de campus', 'Pastor', 'Ministro', 'Administrador', 'Líder', 'Voluntario', 'Admin app']; /* 'Admin app' = el administrador de la aplicación: aprueba accesos y bajas. 'Pastor principal' encabeza la jerarquía (por ahora sin asignar). */
/* Jerarquía para mostrar un solo rol en el perfil (de mayor a menor); 'Admin app' queda fuera de esta jerarquía visible. */
var JERARQUIA_ROLES = ['Pastor principal', 'Pastor de campus', 'Pastor', 'Ministro', 'Administrador', 'Líder', 'Voluntario'];
