function cerradoEnc_(campus, tipo, fecha) {
  var sh = hojas_(campus).ses, n = sh.getLastRow() - 1; if (n < 1) return false;
  var i = { e: SES_COLS.indexOf('encuentro'), f: SES_COLS.indexOf('fecha'), z: SES_COLS.indexOf('finalizado'), v: SES_COLS.indexOf('evento') };
