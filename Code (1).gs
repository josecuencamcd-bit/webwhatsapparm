-radius: 10px; background: var(--danger); color: #fff; font-size: .7rem; align-items: center; justify-content: center; }\n.hi-fila { display: flex; align-items: center; justify-content: space-between; gap: 10px; }\n.soporte-btn, .ayuda-btn { border-color: var(--gold); color: var(--ink); background: var(--surface); }\n</style>\n\n<section class=\"login\" id=\"login\" hidden>\n  <div class=\"panel\">\n    <div class=\"login-brand\"><h1><img class=\"logo\" src=\"data:image/png;base64,\" alt=\"ARM Global\" width=\"200\" height=\"54\"></h1><p class=\"tagline\">La <em>Iglesia</em> es mucho más de lo que te dijeron<span class=\"dot\"></span></p><p>Campus Punta Arenas · Campus Puerto Natales</p></div>\n    <p id=\"login-msg\">Entra con tu correo.</p>\n    <div class=\"field\" id=\"lg-correo-box\">\n      <label class=\"label\" for=\"lg-correo\">Correo</label>\n      <input type=\"email\" id=\"lg-correo\" autocomplete=\"email\" inputmode=\"email\" autocapitalize=\"off\" placeholder=\"tucorreo@gmail.com\">\n    </div>\n    <div class=\"field\" id=\"lg-codigo-box\" hidden>\n      <label class=\"label\" for=\"lg-codigo\">Código que llegó a tu correo</label>\n      <input type=\"text\" id=\"lg-codigo\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" placeholder=\"6 dígitos\">\n    </div>\n    <div class=\"field\" id=\"lg-nombre-box\" hidden>\n      <label class=\"label\" for=\"lg-nombre\">Nombre y apellido</label>\n      <input type=\"text\" id=\"lg-nombre\" autocomplete=\"name\" autocapitalize=\"words\" placeholder=\"Ej: Ana Pérez\">\n    </div>\n    <div class=\"field\" id=\"lg-nota-box\" hidden>\n      <label class=\"label\" for=\"lg-nota\">¿En qué área sirves o quieres servir? (opcional)</label>\n      <input type=\"text\" id=\"lg-nota\" autocomplete=\"off\" placeholder=\"Ej: Kids, Técnica, Conexión\">\n    </div>\n    <div class=\"field\" id=\"lg-clave-box\" hidden>\n      <label class=\"label\" for=\"lg-clave\" id=\"lg-clave-l\">Clave</label>\n      <i