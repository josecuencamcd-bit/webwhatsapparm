}
function normCorreo_(c) {
  c = String(c == null ? '' : c).trim().toLowerCase();
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(c) && c.length <= 120 ? c : '';
}
function propSecreta_(k) {
  var p = PropertiesService.getScriptProperties(), v = p.getProperty(k);
  if (!v) { v = Utilities.getUuid() + Utilities.getUuid(); p.setProperty(k, v); }
  return v;
}
function hex_(bytes) { return bytes.map(function (x) { return ('0' + (x & 255).toString(16)).slice(-2); }).join(''); }
function hashClave_(correo, clave) {
  var h = propSecreta_('SAL') + '|' + correo + '|' + clave;
  for (var i = 0; i < 300; i++) h = hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, h, Utilities.Charset.UTF_8));
  return 'h1:' + h;
}
/** Lista de usuarios (se guarda 60 s en memoria para no leer las hojas en cada consulta). */
function nombreDe_(correo) {
  var t = correo.split('@')[0].replace(/\d+$/, '').replace(/[._-]+/g, ' ').trim();
  return t.replace(/\b[a-záéíóúñ]/g, function (c) { return c.toUpperCase(); }) || correo;
}
function usuarios_() {
  var c = CacheService.getScriptCache(), s = c.get('usr');
  if (s) return JSON.parse(s);
  var sh = usuariosHoja_(), n = sh.getLastRow(), m = {}, cl = {};
  var ch = clavesHoja_(), nc = ch.getLastRow() - 1;
  if (nc > 0) ch.getRange(2, 1, nc, 4).getValues().forEach(function (r, i) {
    var e = normCorreo_(r[0]); if (e) cl[e] = { fila: i + 2, h: String(r[1] || ''), n: String(r[3] || '').trim() };
  });
  if (n > 0) sh.getRange(1, 1, n, 10).getValues().forEach(function (r) {
    var e = normCorreo_(r[0]); if (!e || m[e]) return;
    m[e] = { nh: !!String(r[1] || '').trim(), n: String(r[1] || '').trim() || (cl[e] && cl[e].n) || nombreDe_(e), h: cl[e] ? cl[e].h : '', fila: cl[e] ? cl[e].fila : 0,
             b: /^bloq/i.test(String(r[2] || '').trim()),
             perfil: perfilDe_(r) };
    var pf = m[e].perfil; m[e].roles = pf.roles; m[e].rol = pf.roles[0]; m[e].area = pf.area; m[e].areas = pf.areas; m[e].sirve = pf.sirve; m[e].campus = pf.campus;
    if (pf.roles.length === 1 && pf.roles[0] === 'Voluntario' && !/conexi/i.test(pf.area) && pf.sirve.indexOf('Conexión') < 0) m[e].b = true; /* solo el voluntario de Conexión usa la app */
  });
  var mods = modulosMapa_();
  Object.keys(m).forEach(function (e) { var mm = mods[e]; m[e].modOn = mm ? mm.on : []; m[e].modOff = mm ? mm.off : []; });
  c.put('usr', JSON.stringify(m), 180);
  return m;
}
function firmar_(msg) {
  return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(msg, propSecreta_('SECRETO')));
}
function crearToken_(correo, u) {
  var cuerpo = correo + '|' + (new Date().getTime() + SESION_DIAS * 86400000) + '|' + u.h.slice(3, 11);
  return Utilities.base64EncodeWebSafe(cuerpo, Utilities.Charset.UTF_8) + '.' + firmar_(cuerpo);
}
/** Valida la sesión de quien llama. Si el correo ya no está en la hoja, está bloqueado o cambió su clave, la sesión deja de valer. */
/** Modo prueba ("Ver como" / vista de Pastor del administrador de la app): se puede usar todo; solo se bloquea cambiar correo y clave. */
var VISTA_RO_ = false, VISTA_ = false;
function usuarioDe_(tk) {
  var vp = String(tk || '').split('~'), vistaPedida = vp[1] || ''; tk = vp[0];
  var malo = new Error('SESION_INVALIDA'), p = String(tk || '').split('.');
  if (p.length !== 2) throw malo;
  var cuerpo;
  try { cuerpo = Utilities.newBlob(Utilities.base64DecodeWebSafe(p[0])).getDataAsString(); } catch (e) { throw malo; }
  if (firmar_(cuerpo) !== p[1]) throw malo;
  var q = cuerpo.split('|'), u = usuarios_()[q[0]];
  if (!u || u.b || !u.h || Number(q[1]) < new Date().getTime() || u.h.slice(3, 11) !== q[2]) throw malo;
  VISTA_RO_ = false; VISTA_ = false;
  var vista = vistaPedida;
  if (vista.indexOf('u:') === 0 && u.roles.indexOf('Admin app') >= 0) { /* "Ver como": el administrador de la app usa la app tal como la ve esa persona (modo prueba: lo que registre queda guardado) */
    var cc = normCorreo_(vista.slice(2)), t = usuarios_()[cc];
    if (t && cc !== q[0]) {
      VISTA_ = true;
      return { correo: cc, nombre: t.n, rol: t.rol, roles: t.roles.filter(function (r) { return r !== 'Admin app'; }), area: t.area, areas: t.areas, sirve: t.sirve || [], campus: t.campus, vista: true, vistaPor: q[0], modOn: t.modOn || [], modOff: t.modOff || [] };
    }
  }
  if (vista && ROLES.indexOf(vista) >= 0 && vista !== 'Admin app' && u.roles.indexOf('Admin app') >= 0) {
    VISTA_ = true;
    return { correo: q[0], nombre: u.n, rol: vista, roles: [vista], area: '', areas: [], campus: 'Todos', vista: true, modOn: [], modOff: [] };
  }
  return { correo: q[0], nombre: u.n, rol: u.rol, roles: u.roles, area: u.area, areas: u.areas, sirve: u.sirve || [], campus: u.campus, modOn: u.modOn || [], modOff: u.modOff || [] };
}
function sesionDe_(correo, u) { return { token: crearToken_(correo, u), correo: correo, nombre: u.n, rol: u.rol, roles: u.roles, area: u.area, areas: u.areas, sirve: u.sirve || [], campus: u.campus, appAdmin: esAppAdmin_(u), modOn: u.modOn || [], modOff: u.modOff || [], nombresModulo: nombresModuloMapa_() }; }
