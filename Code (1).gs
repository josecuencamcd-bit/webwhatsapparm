/* ======================================================================
   WhatsApp: alertas junto al correo (WhatsApp Business Cloud API de Meta)
   Se activa solo si existen las Script Properties WA_TOKEN y WA_PHONE_ID.
   Sin esas propiedades, enviarWhatsApp_ no hace nada (no rompe nada).
   ====================================================================== */
function whatsappConfigurado_() {
  try { var p = PropertiesService.getScriptProperties(); return !!(p.getProperty('WA_TOKEN') && p.getProperty('WA_PHONE_ID')); } catch (e) { return false; }
}
/** Normaliza un teléfono chileno a formato E.164 sin '+' (el que pide la API de WhatsApp). */
function telefonoWa_(t) {
  var n = String(t || '').replace(/\D/g, ''); if (!n) return '';
  if (n.charAt(0) === '0') n = n.slice(1);
  if (n.length === 9 && n.charAt(0) === '9') n = '56' + n; /* celular chileno sin código de país */
  return n;
}
/** Teléfono guardado por la persona en "Mi perfil" (hoja Datos personales). */
function telefonoDe_(correo) {
  var e = String(correo || '').toLowerCase();
  var r = filas_('Datos personales', COL_DP).filter(function (x) { return String(x.correo).toLowerCase() === e; })[0];
  return r ? telefonoWa_(r.telefono) : '';
}
/** Envía un WhatsApp de texto simple. Silencioso si no está configurado o si falla (nunca interrumpe el flujo que la llama). */
function enviarWhatsApp_(telefono, texto) {
  if (!telefono || !whatsappConfigurado_()) return false;
  try {
    var p = PropertiesService.getScriptProperties(), token = p.getProperty('WA_TOKEN'), phoneId = p.getProperty('WA_PHONE_ID');
    var res = UrlFetchApp.fetch('https://graph.facebook.com/v20.0/' + phoneId + '/messages', {
      method: 'post', contentType: 'application/json', muteHttpExceptions: true,
      headers: { Authorization: 'Bearer ' + token },
      payload: JSON.stringify({ messaging_product: 'whatsapp', to: telefono, type: 'text', text: { body: String(texto).slice(0, 4000), preview_url: false } })
    });
    if (res.getResponseCode() >= 300) Logger.log('enviarWhatsApp_: ' + res.getContentText());
    return res.getResponseCode() < 300;
  } catch (e) { Logger.log('enviarWhatsApp_: ' + e.message); return false; }
