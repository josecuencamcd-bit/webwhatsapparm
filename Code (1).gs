  if (!whatsappConfigurado_()) return;
  (correos || []).forEach(function (c) { var t = telefonoDe_(c); if (t) enviarWhatsApp_(t, texto); });
}
/** Envía el mismo aviso al grupo de WhatsApp del campus (Propiedad del script WA_GRUPO_NUMEROS: los números de quienes están en ese grupo, separados por coma).
    La API de WhatsApp Business no permite publicar dentro de un grupo ya creado; esta es la forma real de "avisar al grupo" con esa API:
    el mismo mensaje llega por separado a cada número de la lista, en vez de a cada administrador individual. */
function avisoWhatsAppGrupo_(texto) {
  if (!whatsappConfigurado_()) return;
  try {
    var nums = PropertiesService.getScriptProperties().getProperty('WA_GRUPO_NUMEROS') || '';
